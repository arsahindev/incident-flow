# Required server-runtime configuration
API_URL=http://localhost:4000
# Must match the API seed; omit to hide public demo access.
PUBLIC_DEMO_ENVIRONMENT=local

# Required browser configuration; this value is embedded during next build.
# Use the API origin locally, or the explicit `same-origin` value when a reverse
# proxy exposes the Socket.IO endpoint on the web application's host.
# For managed production realtime, set NEXT_PUBLIC_REALTIME_URL=ably at build time.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
