# Required API configuration
DATABASE_URL=postgresql://incidentflow:incidentflow_dev@localhost:5432/incidentflow
WEB_ORIGIN=http://localhost:3000
# Opt in to the shared responder demo when running the seed.
PUBLIC_DEMO_ENVIRONMENT=local
# Local development only. Generate a different production value with: openssl rand -base64 32
PASSWORD_PEPPER=NjecRU8i+JaQiQ+zL5vVbejHj5NQXlYENE/lrnASroc=

# Optional listener and bounded realtime tuning
# Local development uses Socket.IO. Vercel requires ably and a server-only ABLY_API_KEY.
REALTIME_TRANSPORT=socketio
API_HOST=0.0.0.0
API_PORT=4000
REALTIME_MAX_INBOUND_BYTES=4096
REALTIME_MAX_OUTBOUND_BYTES=1024
REALTIME_MAX_INCIDENT_ROOMS=10
REALTIME_MAX_PENDING_PACKETS=20
REALTIME_SESSION_REVALIDATE_MS=60000
