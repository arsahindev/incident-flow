generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentActivityType {
  CREATED
  STATUS_CHANGED
  TEAM_ASSIGNED
  AFFECTED_SERVICES_CHANGED
}

enum ServiceType {
  APPLICATION
  API
  PLATFORM
  INFRASTRUCTURE
  BUSINESS
  EXTERNAL
}

enum ServiceTier {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  DISRUPTED
  MAINTENANCE
}

enum ServiceEnvironmentKind {
  DEVELOPMENT
  TEST
  STAGING
  PRODUCTION
  PREVIEW
  OTHER
}

enum ServiceEnvironmentStatus {
  ACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  RESPONDER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id                  String                    @id @default(uuid()) @db.Uuid
  name                String
  slug                String                    @unique
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  teams               Team[]
  services            Service[]
  serviceEnvironments ServiceEnvironment[]
  incidents           Incident[]
  affectedServices    IncidentAffectedService[]
  activity            IncidentActivity[]
  memberships         OrganizationMembership[]
  teamMemberships     TeamMembership[]
  invitations         Invitation[]
  sessions            Session[]
  auditLog            AuditLog[]

  @@map("organizations")
}

model Team {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  slug           String
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incidents      Incident[]
  ownedServices  Service[]
  memberships    TeamMembership[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("teams")
}

model Incident {
  id               String                    @id @default(uuid()) @db.Uuid
  organizationId   String                    @map("organization_id") @db.Uuid
  teamId           String?                   @map("team_id") @db.Uuid
  title            String
  description      String?
  status           IncidentStatus            @default(OPEN)
  priority         IncidentPriority          @default(MEDIUM)
  version          Int                       @default(1)
  resolvedAt       DateTime?                 @map("resolved_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team             Team?                     @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict)
  activity         IncidentActivity[]
  affectedServices IncidentAffectedService[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@map("incidents")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  displayName             String                   @map("display_name")
  passwordHash            String                   @map("password_hash")
  status                  UserStatus               @default(ACTIVE)
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  organizationMemberships OrganizationMembership[]
  teamMemberships         TeamMembership[]
  sessions                Session[]
  sentInvitations         Invitation[]             @relation("InvitationCreator")
  incidentActivity        IncidentActivity[]
  auditEvents             AuditLog[]               @relation("AuditActor")

  @@map("users")
}

model OrganizationMembership {
  organizationId  String           @map("organization_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  role            OrganizationRole
  status          MembershipStatus @default(ACTIVE)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMemberships TeamMembership[]
  sessions        Session[]

  @@id([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
  @@map("organization_memberships")
}

model TeamMembership {
  organizationId String                 @map("organization_id") @db.Uuid
  teamId         String                 @map("team_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team                   @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@id([organizationId, teamId, userId])
  @@index([organizationId, userId])
  @@map("team_memberships")
}

model Session {
  id             String                 @id @default(uuid()) @db.Uuid
  tokenHash      String                 @unique @map("token_hash") @db.Char(64)
  userId         String                 @map("user_id") @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  expiresAt      DateTime               @map("expires_at")
  lastUsedAt     DateTime               @default(now()) @map("last_used_at")
  revokedAt      DateTime?              @map("revoked_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([organizationId, userId])
  @@map("sessions")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  email           String
  role            OrganizationRole
  tokenHash       String           @unique @map("token_hash") @db.Char(64)
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  revokedAt       DateTime?        @map("revoked_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitationCreator", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, email, acceptedAt, revokedAt])
  @@index([expiresAt])
  @@map("invitations")
}

model LoginThrottle {
  keyHash         String    @id @map("key_hash") @db.Char(64)
  attemptCount    Int       @default(0) @map("attempt_count")
  windowStartedAt DateTime  @default(now()) @map("window_started_at")
  lockedUntil     DateTime? @map("locked_until")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([lockedUntil])
  @@map("login_throttles")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

model Service {
  id                String                    @id @default(uuid()) @db.Uuid
  organizationId    String                    @map("organization_id") @db.Uuid
  ownerTeamId       String?                   @map("owner_team_id") @db.Uuid
  name              String
  slug              String
  description       String?
  type              ServiceType
  tier              ServiceTier               @default(MEDIUM)
  status            ServiceStatus             @default(OPERATIONAL)
  archivedAt        DateTime?                 @map("archived_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerTeam         Team?                     @relation(fields: [organizationId, ownerTeamId], references: [organizationId, id], onDelete: Restrict)
  environments      ServiceEnvironment[]
  affectedIncidents IncidentAffectedService[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId, archivedAt, name])
  @@index([organizationId, ownerTeamId])
  @@map("services")
}

model ServiceEnvironment {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  serviceId      String                   @map("service_id") @db.Uuid
  name           String
  slug           String
  kind           ServiceEnvironmentKind
  isEphemeral    Boolean                  @default(false) @map("is_ephemeral")
  /// PostgreSQL also enforces that only ephemeral environments may have an expiry.
  expiresAt      DateTime?                @map("expires_at")
  status         ServiceEnvironmentStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service                  @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, serviceId, slug])
  @@index([organizationId, serviceId, status])
  @@index([organizationId, expiresAt])
  @@map("service_environments")
}

model IncidentAffectedService {
  organizationId String       @map("organization_id") @db.Uuid
  incidentId     String       @map("incident_id") @db.Uuid
  serviceId      String       @map("service_id") @db.Uuid
  isPrimary      Boolean      @default(false) @map("is_primary")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident       Incident     @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Cascade)
  service        Service      @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict)

  @@id([incidentId, serviceId])
  @@index([organizationId, serviceId, createdAt])
  @@index([organizationId, incidentId])
  @@map("incident_affected_services")
}

model IncidentActivity {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  incidentId     String               @map("incident_id") @db.Uuid
  actorUserId    String?              @map("actor_user_id") @db.Uuid
  type           IncidentActivityType
  message        String
  fromValue      String?              @map("from_value")
  toValue        String?              @map("to_value")
  createdAt      DateTime             @default(now()) @map("created_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident       Incident             @relation(fields: [organizationId, incidentId], references: [organizationId, id], onDelete: Cascade)
  actor          User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, incidentId, createdAt])
  @@map("incident_activity")
}
