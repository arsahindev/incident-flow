{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@incidentflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "test:integration": "RUN_DATABASE_TESTS=true node --import tsx --test --test-concurrency=1 src/*.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "fastify": "^5.0.0",
    "pg": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.4",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
